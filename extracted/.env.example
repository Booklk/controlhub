# ==================== REQUIRED ====================
DATABASE_URL=postgresql://user:password@localhost:5432/controlhub

# Generate each with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32_INDEPENDENT

# ==================== OPTIONAL ====================
SEED_PASSWORD=ControlHub@2026        # Dev seed accounts password
PORT=5000
NODE_ENV=development                  # Set to: production

# SMTP Email
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@your-domain.sa
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@your-domain.sa
SMTP_FROM_NAME=مركز التحكم - JCSA

# App URLs
APP_URL=https://controlhub.jcsa.sa
LOGO_URL=https://controlhub.jcsa.sa/logo.png

# Security (optional)
HEALTH_SECRET=your-monitoring-secret  # Required in X-Health-Secret header to access /health
DISABLE_CSRF=false                    # Never set true in production

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/controlhub/app.log  # Production only
